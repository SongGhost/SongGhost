@import "tailwindcss";

:root {
  /* Main App Background — Deep Charcoal (bg-zinc-950) */
  --background: #121212;
  /* Secondary Cards & Panels — Dark Zinc (bg-zinc-900 / bg-zinc-800) */
  --surface: #1e1e24;
  --surface-elevated: #27272a;
  /* Primary Text — Off-White (text-zinc-100) */
  --foreground: #f4f4f5;
  /* Muted Text — Soft Gray (text-zinc-400) */
  --muted-foreground: #a1a1aa;
  /* Brand Highlight — warm amber, retained for active rings/glows/VU meters */
  --station-accent: #f59e0b;
}

@theme inline {
  --font-sans: var(--font-sans);
  --font-mono: var(--font-mono);
}

* {
  box-sizing: border-box;
}

/*
 * Pull-to-refresh guard (Phase 3 Step 3D).
 *
 * Mobile Safari/Chrome treat the document root as the outermost scroller and
 * read an overscroll at its top as "pull to refresh". A refresh mid-broadcast
 * would tear down the YouTube embed and DJ voice node instantly with no
 * recovery path, so the root is locked down entirely rather than merely
 * contained — there is no legitimate reason for `html`/`body` itself to
 * rubber-band.
 */
html {
  overscroll-behavior-y: none;
}

body {
  min-height: 100vh;
  overscroll-behavior-y: none;
}

/*
 * Scoped containment for the app's own scrollable surfaces — modals, drawers,
 * and the mobile player sheet. `contain` (not `none`) is deliberate: it stops
 * a maxed-out inner scroll from chaining into the page behind it, which is
 * the gesture that would otherwise reach the `html`/`body` guard above from
 * the inside, while still letting the surface itself scroll and rubber-band
 * normally.
 */
.overscroll-region {
  overscroll-behavior-y: contain;
}

/* Touch toolbars (memory presets) — hide the scrollbar chrome, keep swipe. */
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* Dark hardware badge mounted on wood chassis */
.chassis-badge {
  display: inline-block;
  background-color: #1c1917;
  color: #fbbf24;
  border: 1px solid #292524;
  font-family: var(--font-mono), ui-monospace, monospace;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.25rem 0.75rem;
  border-radius: 0.375rem;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  margin-bottom: 0.75rem;
}

/* Song progress slider — sits on the sticky player header */
.song-progress-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  max-width: 100%;
  height: 4px;
  border-radius: 9999px;
  background: #d6d3d1;
  outline: none;
  cursor: pointer;
  box-sizing: border-box;
}

.song-progress-slider:disabled {
  opacity: 0.35;
  cursor: default;
}

.song-progress-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #d97706;
  box-shadow: 0 2px 6px rgba(217, 119, 6, 0.4);
  border: 2px solid #18181b;
}

.song-progress-slider::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #d97706;
  box-shadow: 0 2px 6px rgba(217, 119, 6, 0.4);
  border: 2px solid #18181b;
}

/* Master volume slider */
.volume-range {
  -webkit-appearance: none;
  appearance: none;
  height: 6px;
  border-radius: 0.5rem;
  background: #d6d3d1;
  outline: none;
  accent-color: #f59e0b;
}

.volume-range::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #f59e0b;
  border: 2px solid #18181b;
  box-shadow: 0 2px 6px rgba(245, 158, 11, 0.35);
  cursor: pointer;
}

.volume-range::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #f59e0b;
  border: 2px solid #18181b;
  box-shadow: 0 2px 6px rgba(245, 158, 11, 0.35);
  cursor: pointer;
}
</file>

