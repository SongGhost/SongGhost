import { describe, expect, it } from "vitest";
import type { StationTrack } from "@/data/stations";
import {
  EMPTY_TRACK_FEEDBACK,
  normalizeArtistKey,
  withBan,
  withCompletedListen,
  withSkip,
  type TrackFeedback,
} from "@/lib/user/feedback";
import type { AlbumContext } from "@/types/station";
import {
  albumMatchesEra,
