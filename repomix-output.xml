  djPacingFrequency: DEFAULT_DJ_PACING,
  chatterPacing: DEFAULT_CHATTER_PACING,
  visualizerMode: DEFAULT_VISUALIZER_MODE,
  playHistory: [],
  likedTracks: [],
  savedStations: [],
  memoryPresets: createEmptyMemoryPresets(),
  stationConfigs: {},
};
